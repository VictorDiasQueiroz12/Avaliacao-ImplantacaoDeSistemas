  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "supertest": "^7.3.2"
  }
}
