    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:all": "npm run test && npm run test:integration",
    "test:e2e": "node scripts/e2e.js",
    "test:browser": "node --test tests/browser/*.test.js"
  },
