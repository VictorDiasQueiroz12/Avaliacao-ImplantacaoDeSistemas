{
  "name": "estulanches",
  "version": "1.0.0",
  "description": "Cardápio e pedidos da cantina escolar",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
