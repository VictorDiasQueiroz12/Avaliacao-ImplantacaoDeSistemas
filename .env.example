PORT=3000
POSTGRES_DB=estulanches
POSTGRES_USER=estulanches
POSTGRES_PASSWORD=troque_esta_senha_local
# Node fora do Docker; o serviço app do Compose usa PGHOST/PGUSER/etc.
DATABASE_URL=postgresql://estulanches:troque_esta_senha_local@localhost:5432/estulanches
# Banco exclusivo de testes; nunca aponte para desenvolvimento ou produção.
TEST_DATABASE_URL=postgresql://estulanches:troque_esta_senha_local@localhost:5432/estulanches_test
